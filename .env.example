# Copy to ~/stock-mcp/.env on the deploy host. Quote values that contain spaces.

# Bind address. 0.0.0.0 = LAN-reachable. 127.0.0.1 = local only.
STOCK_MCP_HOST=0.0.0.0
STOCK_MCP_PORT=39200

# Extra Host/Origin entries (comma-separated) for FastMCP's DNS-rebinding protection.
# Always include the LAN address you expose so MCP clients can reach the server.
STOCK_MCP_ALLOWED_HOSTS=192.168.1.2:39200,192.168.1.2
STOCK_MCP_ALLOWED_ORIGINS=http://192.168.1.2:39200

# Alpha Vantage (free key from https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=

# Finnhub (free key from https://finnhub.io/register).
# Real-time US stock quotes — finnhub_quote tool. Free tier: 60 req/min.
FINNHUB_API_KEY=

# Stooq (apikey required since 2025; get one at
# https://stooq.com/q/d/?s=aapl.us&get_apikey — fill captcha, copy the key).
# Without this, stooq_history and source='stooq' tools return a clear error.
STOOQ_API_KEY=

# chart-img.com (TradingView-style chart images for generate_chart_image).
# Free tier available; leave blank to disable. Local fallback is generate_chart_local (no key).
CHART_IMG_API_KEY=

# OAuth 2.1 (optional — leave both empty to run LAN-only without authentication).
# When both ISSUER_URL and MASTER_PASSWORD are set, stock-mcp publishes the
# MCP-standard OAuth endpoints (/.well-known/oauth-authorization-server,
# /authorize, /token, /register, /revoke) and adds a /consent page for the
# user to approve new clients. Required to add stock-mcp as a Custom Connector
# from claude.ai (web) or Claude desktop/iOS.
#
# Issuer URL = the public HTTPS URL Claude.ai sees (NOT 192.168.1.2:39200).
# This must match the host Caddy uses (e.g. https://stockmcp.kitepon.dev).
# MCP_OAUTH_ISSUER_URL=https://stockmcp.kitepon.dev
# MCP_OAUTH_MASTER_PASSWORD=
# MCP_OAUTH_DB_PATH=data/oauth.db    # SQLite store for clients + tokens (persists across restarts)

# kabu.com Station API (only if you have kabu Station installed and reachable from this host)
# Live trading port: 18080. Test port: 18081.
KABU_BASE_URL=
KABU_API_PASSWORD=
KABU_PRODUCTION=false

# === Marketspeed2 (Rakuten Securities) integration ===
# Bridge HTTP service that runs on the Windows host where Marketspeed2 + Excel +
# RSS are installed. See tools/ms2-bridge/ for the bridge code and setup steps.
MS2_BRIDGE_URL=
# Bearer token shared with the Windows bridge. MUST match MS2_BRIDGE_TOKEN on
# the bridge .env. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MS2_BRIDGE_TOKEN=

# === Order-execution safety knobs (Marketspeed2 only) ===
# Master switch: when 'true', register the ms2_*_preview / ms2_*_confirm tools.
# Leave 'false' to expose read-only MS2 tools only.
STOCK_MCP_ENABLE_ORDERS=false
# Per-order guards. Enforced in the preview step; exceeding either rejects the order.
STOCK_MCP_MAX_ORDER_QTY=1000
STOCK_MCP_MAX_ORDER_NOTIONAL=5000000
# HMAC secret used to sign confirm_tokens. If unset, a random 32-byte hex is
# generated at process start (tokens then don't survive restarts — fine).
STOCK_MCP_CONFIRM_TOKEN_SECRET=
# confirm_token TTL in seconds.
STOCK_MCP_CONFIRM_TOKEN_TTL=60
