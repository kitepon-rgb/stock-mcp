# Copy this file to .env (in this same directory) and fill in.

# Bearer token shared with the stock-mcp server (which sets MS2_BRIDGE_TOKEN
# to the same value). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MS2_BRIDGE_TOKEN=

# Bind address. 0.0.0.0 = LAN-reachable. 127.0.0.1 = local only.
MS2_BRIDGE_HOST=0.0.0.0
MS2_BRIDGE_PORT=39201

# Enable order-mutating endpoints. Keep false until you're ready to place real orders.
# stock-mcp also has STOCK_MCP_ENABLE_ORDERS — BOTH must be true for live order flow.
MS2_BRIDGE_ENABLE_ORDERS=false

# Dry-run: when true, place/cancel/modify endpoints return a stub instead of
# calling RSS order functions. Useful for end-to-end wiring tests.
MS2_BRIDGE_DRY_RUN=true

# Absolute path to the Excel workbook that has the RSS add-in loaded.
# If blank, the bridge attaches to whichever workbook is currently active.
MS2_WORKBOOK_PATH=
